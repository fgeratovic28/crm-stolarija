VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Javni URL deployovanog frontenda (bez / na kraju). Obavezno za ispravan QR na narudžbenici
# kada PDF/štampa generišete lokalno — inače QR pokazuje na localhost.
# Primer: https://crm.vasadomena.rs
VITE_PUBLIC_APP_URL=

# Javni bazni URL R2 (r2.dev ili custom domena), BEZ završnog /. Ne sadrži secret.
VITE_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# R2 tajne (Access Key / Secret / Account ID / bucket) NIKAD ovde — samo u:
# Supabase → Project Settings → Edge Functions → Secrets (za funkciju r2-storage)


# API ruta za slanje ponuda (server-only env)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Termo Plast CRM <onboarding@resend.dev>

# Nabavka — slanje porudžbine dobavljaču (odvojen Resend nalog; server-only)
RESEND_PROCUREMENT_API_KEY=
# Navodnici obavezni zbog < > u adresi
RESEND_PROCUREMENT_FROM_EMAIL="Termo Plast Nabavka <ivan@nabavka.crmtermoplast.online>"
RESEND_PROCUREMENT_REPLY_TO=fgeratovic03@gmail.com

# Nabavka — inbound (Resend webhook na /api/inbound-email/procurement-webhook)
RESEND_PROCUREMENT_WEBHOOK_SECRET=whsec_xxxxxxxxx
PROCUREMENT_EMAIL_FORWARD_TO=fgeratovic03@gmail.com
PROCUREMENT_FORWARD_FROM_EMAIL=ivan@nabavka.crmtermoplast.online

# Frontend endpoint za slanje ponude (Vite klijent):
# - Lokalno uz poseban backend: npr. http://localhost:3000/api/quotes/send
# - Na produkciji (isti domen): ostavite prazno i koristi se /api/quotes/send
VITE_QUOTE_SEND_API_URL=

# Nabavka — slanje mejla dobavljaču (isti domen na produkciji; prazno = /api/material-orders/send-email)
VITE_PROCUREMENT_EMAIL_API_URL=

# Inbound email forwarding (Resend webhook)
# Webhook secret from Resend Dashboard -> Webhooks -> your webhook -> signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Email address to which all received emails are forwarded (defaults to fgeratovic03@gmail.com)
EMAIL_FORWARD_TO=fgeratovic03@gmail.com
# From address used when forwarding (must be a verified domain in Resend)
FORWARD_FROM_EMAIL=ponude@crmtermoplast.online

# SQL backup (cron + ručni admin trigger)
# Supabase service key samo na serveru (Vercel env), NIKAD u klijentu.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Cloudflare R2 (S3 kompatibilan) za SQL backup fajlove
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Playwright E2E — vidi `.env.playwright.example` (kopija u `.env.playwright`, u .gitignore).
